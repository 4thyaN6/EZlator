# ==== Build output and caches ====
# Regenerated by every build, so they are never uploaded
# ==== 빌드 결과물과 캐시 ====
# 빌드할 때마다 다시 생기므로 올리지 않음
*.iml
.gradle
/.idea/
/.kotlin/
/build
/captures
.externalNativeBuild
.cxx
/app/build/
/app/release/
/app/debug/
*.apk
*.aab
.DS_Store
# Output of the dependency listing command
# 의존성 목록 명령으로 생기는 파일임
/deps.txt

# ==== Local machine settings ====
# Holds the SDK path of this PC only
# ==== 이 PC 전용 설정 ====
# 이 PC의 SDK 경로만 들어 있음
/local.properties

# ==== Signing keys ====
# Release keys must never be uploaded; only the test key from the original project is allowed
# ==== 서명 키 ====
# 배포 키는 절대 올리지 않음. 원본 프로젝트의 테스트 키만 예외로 허용함
*.jks
*.keystore
!/app/testkey_untrusted.jks
keystore.properties

# ==== Win Components (Microsoft DLL packages) ====
# Not kept in the repository.
# wincomponents.json is read by the code, so it stays. opengl/ddraw are MIT builds, so they stay.
# ==== Win Components (Microsoft DLL 묶음) ====
# 저장소에는 올리지 않음
# wincomponents.json은 코드가 읽으므로 올림. opengl/ddraw는 MIT 빌드라 올림
/app/src/main/assets/wincomponents/*.tzst
# Uncompressed packages too (vcrun2015.tar, made by local_tools/pack_vcrun2015)
# 압축하지 않은 묶음도 제외함(vcrun2015.tar, local_tools/pack_vcrun2015로 만듦)
/app/src/main/assets/wincomponents/*.tar
!/app/src/main/assets/wincomponents/opengl.tzst
!/app/src/main/assets/wincomponents/ddraw.tzst

