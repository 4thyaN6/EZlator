        <item
            android:id="@+id/main_menu_magnifier"
            android:title="@string/magnifier"
            android:icon="@drawable/icon_magnifier" />
        <item
            android:id="@+id/main_menu_pip_mode"
            android:title="@string/pip_mode"
            android:icon="@drawable/ic_picture_in_picture_alt" />
    </group>

    <!-- ===== SYSTEM ===== -->
    <item
        android:id="@+id/header_system"
        android:title="@string/menu_section_system"
        android:icon="@drawable/icon_settings" />
    <group
