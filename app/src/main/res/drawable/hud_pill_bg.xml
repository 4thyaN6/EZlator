<?xml version="1.0" encoding="utf-8"?>
<!-- Semi-transparent dark pill behind the in-game HUD, readable on any picture
     게임 중 HUD 뒤의 반투명 어두운 알약임. 어떤 화면 위에서도 읽힘 -->
