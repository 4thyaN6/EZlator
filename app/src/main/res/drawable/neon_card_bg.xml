<?xml version="1.0" encoding="utf-8"?>
<!--
    Faked outer glow: three stacked strokes from soft to solid.
    Android XML shapes cannot blur, so the alpha ramp does the work.
    가짜 외곽 발광임. 연함에서 진함 순으로 테두리 3겹을 쌓음.
    XML 도형은 블러가 안 되므로 알파 단계로 대신함
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outermost halo / 가장 바깥 후광 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="?attr/neonGlowSoft" />
        </shape>
    </item>

    <!-- Middle band / 중간 띠 -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/neonGlowMid" />
        </shape>
    </item>

    <!-- Card face plus the crisp 1dp neon edge / 카드 면과 선명한 1dp 네온 모서리 -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="?attr/neonSurface" />
            <stroke android:width="1dp" android:color="?attr/neonGlowMid" />
        </shape>
    </item>
</layer-list>
