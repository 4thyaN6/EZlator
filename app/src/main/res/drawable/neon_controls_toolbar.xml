<?xml version="1.0" encoding="utf-8"?>
<!--
    Floating toolbar for the Controls Editor canvas. Kept opaque (neonSurface
    is a solid colour, not a translucent black) because this bar sits over an
    arbitrary drag-and-drop canvas and needs to stay readable regardless of
    what's under it - the same reasoning as the shortcut detail sheet's scrim.
    컨트롤러 에디터 캔버스 위에 뜨는 툴바임. 반투명 검정이 아니라 불투명한
    neonSurface를 씀. 이 바가 임의의 드래그 편집 캔버스 위에 떠서 밑에 뭐가
    있든 읽혀야 하기 때문임 - 숏컷 상세창의 어둠막과 같은 이유임
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/neonSurface" />
    <corners android:radius="14dp" />
    <stroke android:width="1dp" android:color="?attr/neonGlowMid" />
</shape>
