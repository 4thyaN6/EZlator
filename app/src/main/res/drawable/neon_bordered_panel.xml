<?xml version="1.0" encoding="utf-8"?>
<!--
    Replaces bordered_panel.xml (transparent fill, #eeeeee stroke - nearly
    invisible on a light neon background, and dead flat on dark). Used by the
    CPU/Memory info boxes and as the Task Manager list's outer frame.
    bordered_panel.xml(투명 채움 + #eeeeee 테두리 - 라이트 네온 배경에서 거의
    안 보이고 다크에서는 밋밋함)을 대체함. CPU/메모리 정보 박스와 태스크
    매니저 목록의 바깥 틀에 씀
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="?attr/neonSurface" />
    <stroke android:width="1dp" android:color="?attr/neonGlowMid" />
</shape>
