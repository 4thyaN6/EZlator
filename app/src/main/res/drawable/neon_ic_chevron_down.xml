<?xml version="1.0" encoding="utf-8"?>
<!--
    Dropdown chevron for the neon combo box. The old ComboBox style reserved
    36dp of right padding for an arrow, but combo_box_bg.xml never drew one,
    so every dropdown looked like a plain text field.
    네온 콤보박스용 드롭다운 화살표임. 기존 ComboBox 스타일은 화살표 자리로
    오른쪽 여백 36dp를 비워 뒀지만 combo_box_bg.xml이 화살표를 그리지 않아서,
    모든 드롭다운이 그냥 입력칸처럼 보였음
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="18dp"
    android:height="18dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="?attr/neonAccent"
        android:pathData="M7.41,8.59L12,13.17l4.59,-4.58L18,10l-6,6 -6,-6 1.41,-1.41z" />
</vector>
