<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing knob for SeekBar / SeekBar용 빛나는 손잡이 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="22dp" android:height="22dp" />
            <solid android:color="?attr/neonGlowSoft" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <size android:width="12dp" android:height="12dp" />
            <solid android:color="?attr/neonAccent" />
        </shape>
    </item>
</layer-list>
