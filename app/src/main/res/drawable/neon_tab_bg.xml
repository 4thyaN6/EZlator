<?xml version="1.0" encoding="utf-8"?>
<!--
    Tab strip background: window colour plus a 1dp hairline at the bottom.
    The neon indicator sits on top of that line, so the active tab reads as
    lit rather than merely underlined.
    탭 줄 배경임: 창 배경색에 아래쪽 1dp 실선을 둠. 네온 표시줄이 그 실선
    위에 올라가서 선택된 탭이 밑줄이 아니라 불이 켜진 것처럼 보임
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/neonDivider" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/neonBg" />
        </shape>
    </item>
</layer-list>
