<?xml version="1.0" encoding="utf-8"?>
<!--
    Dropdown list panel. Replaces content_dialog_background(_dark), which the
    Java side used to swap in by hand for every spinner.
    드롭다운 목록 패널임. Java에서 스피너마다 손으로 갈아 끼우던
    content_dialog_background(_dark)를 대체함
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="?attr/neonSurface" />
    <stroke android:width="1dp" android:color="?attr/neonGlowMid" />
</shape>
