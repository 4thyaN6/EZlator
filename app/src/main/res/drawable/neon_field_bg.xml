<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings section container. Deliberately dimmer than a card - a settings
    screen with 12 glowing boxes is unreadable, so only the section title glows.
    설정 구역 상자임. 카드보다 일부러 흐리게 함 - 빛나는 상자 12개가 깔린
    설정 화면은 못 읽으므로 구역 제목만 빛나게 함
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <solid android:color="?attr/neonSurface" />
    <stroke android:width="1dp" android:color="?attr/neonDivider" />
</shape>
