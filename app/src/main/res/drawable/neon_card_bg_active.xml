<?xml version="1.0" encoding="utf-8"?>
<!--
    Pressed / selected state - same geometry, full-strength stroke.
    Keeping the geometry identical prevents the 1px jump on touch.
    눌림 / 선택 상태임. 형태는 같고 테두리만 최대 세기로 감.
    형태를 똑같이 유지해야 터치할 때 1px 튀는 현상이 없음
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="?attr/neonGlowMid" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/neonGlow" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="?attr/neonSurfaceAlt" />
            <stroke android:width="1dp" android:color="?attr/neonGlow" />
        </shape>
    </item>
</layer-list>
