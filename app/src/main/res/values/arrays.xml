    <!-- These must match the .tzst filenames actually shipped in assets/, because -->
    <!-- they are extracted as assets/box86_64/box64-<item>.tzst. "0.4.3" was never -->
    <!-- bundled, so the offline fallback silently extracted nothing. -->
    <!-- 여기 항목은 assets/box86_64/box64-<항목>.tzst 로 압축 해제되므로 -->
    <!-- assets/에 실제로 들어 있는 파일명과 일치해야 함. "0.4.3"은 번들된 적이 -->
    <!-- 없어서 오프라인 폴백이 조용히 아무것도 풀지 않았음 -->
    <string-array name="box64_version_entries">
        <item>0.3.2</item>
        <item>0.3.6</item>
        <item>0.3.7</item>
    </string-array>
    <!-- Extracted as assets/wowbox64/wowbox64-<item>.tzst - same rule as above -->
    <!-- assets/wowbox64/wowbox64-<항목>.tzst 로 풀리므로 위와 동일한 규칙 -->
    <string-array name="wowbox64_version_entries">
        <item>0.3.4</item>
        <item>0.3.7</item>
    </string-array>
    <!-- Intentionally empty. assets/fexcore/ only ships 2505 and 2507, both older than -->
