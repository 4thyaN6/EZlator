    <!-- Bundled driver assets were deleted; only the device's own driver stays as a -->
    <!-- built-in option. Turnip builds now come from the download flow only. -->
    <!-- 번들 드라이버 에셋을 삭제했으므로 내장 선택지는 기기 자체 드라이버만 남김. -->
    <!-- Turnip 계열은 이제 다운로드로만 제공됨 -->
