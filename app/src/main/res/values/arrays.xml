    <!-- DXVK and VKD3D are no longer separate, mutually-exclusive choices. -->
    <!-- Real Wine/Proton setups always run them together (DXVK for D3D9-11, -->
    <!-- VKD3D for D3D12), so they're now one combined option that opens a -->
    <!-- single config screen with both version spinners. -->
    <!-- DXVK와 VKD3D는 더 이상 서로 배타적인 별개 선택지가 아님. -->
    <!-- 실제 Wine/Proton 환경에서는 항상 같이 동작하므로(DXVK=D3D9~11, -->
    <!-- VKD3D=D3D12), 이제 하나의 통합 옵션으로 합치고, 그 안에서 -->
    <!-- DXVK/VKD3D 버전을 각각 고르는 설정 화면 하나를 씀 -->
    <string-array name="dxwrapper_entries">
        <item>WineD3D</item>
        <item>DXVK + VKD3D</item>
    </string-array>
    <string-array name="ddrawrapper_entries">
        <item>CnC-DDraw</item>
        <item>Dd7To9</item>
        <item>WineD3D</item>
    </string-array>
    <!-- Intentionally empty. Items here are treated as bundled assets and resolve to -->
    <!-- assets/dxwrapper/dxvk-<item>.tzst, which does not exist for any of these. They -->
    <!-- also fail profile lookup because the version code cannot be parsed out of the -->
    <!-- name, so selecting one installed nothing at all. DXVK now comes only from -->
    <!-- ContentsManager (recommended downloads / Contents screen). -->
    <!-- 의도적으로 비움. 여기 항목은 번들 에셋으로 간주되어 -->
    <!-- assets/dxwrapper/dxvk-<항목>.tzst 를 찾는데, 해당 파일이 하나도 없음. -->
    <!-- 게다가 이름에서 버전 코드를 분리할 수 없어 프로필 조회도 실패하므로 -->
    <!-- 고르면 아무것도 설치되지 않았음. 이제 DXVK는 ContentsManager(추천 -->
    <!-- 다운로드 / Contents 화면)를 통해서만 제공됨 -->
    <string-array name="dxvk_version_entries">
    </string-array>
