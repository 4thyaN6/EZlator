    <!-- now comes only from ContentsManager. -->
    <!-- 의도적으로 비움. assets/fexcore/에는 2505, 2507만 있고 둘 다 다운로드 -->
    <!-- 카탈로그보다 구버전이며 "2607"은 에셋 자체가 없었음. FEXCore는 이제 -->
    <!-- ContentsManager를 통해서만 제공됨 -->
