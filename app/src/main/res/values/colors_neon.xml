<?xml version="1.0" encoding="utf-8"?>
<!--
    Raw palette values. Nothing in a layout should point here directly -
    layouts use ?attr/neonXxx, and the themes map those attrs onto these colors.
    Name prefix "neon_" keeps this file from colliding with the existing colors.xml.
    원색 정의임. 레이아웃이 여기를 직접 가리키면 안 됨 -
    레이아웃은 ?attr/neonXxx를 쓰고, 테마가 그 속성을 이 색에 연결함.
    이름 앞에 "neon_"을 붙여 기존 colors.xml과 충돌하지 않게 함
-->
<resources>

    <!-- ============ LIGHT: white + pink + sky ============ -->
    <!-- ============ 라이트: 흰색 + 분홍 + 하늘 ============ -->

    <!-- Not pure white. #FFFFFF next to a neon stroke produces halation and -->
    <!-- is the main reason the current screens read as flat and tiring. -->
    <!-- 순백이 아님. #FFFFFF는 네온 테두리 옆에서 번짐이 생기고, -->
    <!-- 지금 화면이 밋밋하고 눈이 피로한 주된 이유임 -->
    <color name="neon_l_bg">#F5F6FB</color>
    <color name="neon_l_surface">#FFFFFF</color>
    <color name="neon_l_surface_alt">#EDEFF7</color>

    <color name="neon_l_accent">#FF2E88</color>   <!-- pink / 분홍 -->
    <color name="neon_l_accent2">#00BFE8</color>  <!-- sky / 하늘 -->
    <color name="neon_l_accent3">#7C5CFF</color>  <!-- bridging violet / 이어 주는 보라 -->

    <!-- Near-black rather than black: 21:1 contrast is harsher than needed -->
    <!-- 완전 검정 대신 거의 검정. 21:1 대비는 필요 이상으로 날카로움 -->
    <color name="neon_l_text">#10131C</color>
    <color name="neon_l_text_dim">#59617A</color>

    <color name="neon_l_glow">#FF2E88</color>
    <color name="neon_l_glow_mid">#59FF2E88</color>
    <color name="neon_l_glow_soft">#1FFF2E88</color>

    <color name="neon_l_divider">#1A10131C</color>
    <color name="neon_l_disabled">#B4BAC9</color>
    <!-- White veil, 85%. Light mode keeps the detail sheet white like the rest
         of the theme while the cover still tints through
         흰색 막 85%. 라이트 모드에서 상세창이 테마의 나머지와 같은 흰색을
         유지하면서도 커버가 옅게 비쳐 보임 -->
    <color name="neon_l_scrim">#33FFFFFF</color>

    <!-- ============ DARK: black + sky + purple + blue ============ -->
    <!-- ============ 다크: 검정 + 하늘 + 보라 + 파랑 ============ -->

    <!-- Slight blue cast keeps the black from looking like a dead pixel field -->
    <!-- 살짝 푸른 기를 넣어야 검정이 죽은 화면처럼 안 보임 -->
    <color name="neon_d_bg">#07070D</color>
    <color name="neon_d_surface">#101019</color>
    <color name="neon_d_surface_alt">#181826</color>

    <color name="neon_d_accent">#00E5FF</color>   <!-- sky / 하늘 -->
    <color name="neon_d_accent2">#B24BFF</color>  <!-- purple / 보라 -->
    <color name="neon_d_accent3">#2F6BFF</color>  <!-- blue / 파랑 -->

    <color name="neon_d_text">#E9EFFF</color>
    <color name="neon_d_text_dim">#8D97B5</color>

    <color name="neon_d_glow">#00E5FF</color>
    <color name="neon_d_glow_mid">#5900E5FF</color>
    <color name="neon_d_glow_soft">#1F00E5FF</color>

    <color name="neon_d_divider">#26FFFFFF</color>
    <color name="neon_d_disabled">#414962</color>
    <!-- Black veil, 65%. Lowered from 77% so the cover is clearly visible
         behind the text instead of being nearly blacked out
         검정 막 65%. 77%에서 낮춤. 커버가 거의 까맣게 덮이지 않고 글자 뒤로
         분명히 보이게 하기 위함 -->
    <color name="neon_d_scrim">#33000000</color>

</resources>
