<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Light Theme -->
    <!-- Several layouts (main_activity, container_detail_fragment, etc.) use
     Material Components widgets, which enforce a MaterialComponents theme at
     runtime. The ".Bridge" variants keep every AppCompat widget style as-is and
     only add the Material attributes, so existing colors/styles don't shift. -->
    <!-- 여러 레이아웃(main_activity, container_detail_fragment 등)이 Material
         Components 위젯을 쓰는데, 이게 실행 시 MaterialComponents 계열 테마를
         강제로 요구함. ".Bridge" 계열은 기존 AppCompat 위젯 스타일을 그대로
         두고 Material 속성만 추가하므로 색상/스타일이 바뀌지 않음 -->
    <style name="AppTheme" parent="@style/Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="android:windowBackground">@color/window_background_color</item>
        <item name="android:colorBackground">@color/window_background_color</item>
        <item name="android:textViewStyle">@style/TextView</item>
        <item name="android:checkboxStyle">@style/CheckBox</item>
        <item name="android:listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="listPopupWindowStyle">@style/ListPopupWindow</item>
        <item name="android:popupWindowStyle">@style/PopupWindow</item>
        <item name="popupWindowStyle">@style/PopupWindow</item>
        <item name="android:popupMenuStyle">@style/PopupMenu</item>
        <item name="popupMenuStyle">@style/PopupMenu</item>
    </style>

    <!-- Dark Theme -->
    <style name="AppTheme.Dark" parent="@style/Theme.MaterialComponents.NoActionBar.Bridge">
        <item name="colorAccent">@color/colorAccentDark</item>
        <item name="colorPrimary">@color/colorPrimaryDarkMode</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkModeDark</item>
        <item name="android:windowBackground">@color/window_background_color_dark</item>
        <item name="android:colorBackground">@color/window_background_color_dark</item>
        <item name="android:textViewStyle">@style/TextView.Dark</item>
        <item name="android:checkboxStyle">@style/CheckBox.Dark</item>
        <item name="android:listPopupWindowStyle">@style/ListPopupWindow.Dark</item>
        <item name="listPopupWindowStyle">@style/ListPopupWindow.Dark</item>
        <item name="android:popupWindowStyle">@style/PopupWindow.Dark</item>
        <item name="popupWindowStyle">@style/PopupWindow.Dark</item>
        <item name="android:popupMenuStyle">@style/PopupMenu.Dark</item>
        <item name="popupMenuStyle">@style/PopupMenu.Dark</item>
    </style>

    <!-- Light Theme Fullscreen -->
    <style name="AppThemeFullscreen" parent="@style/AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>


    <!-- Base ComboBox Styles -->
    <style name="ComboBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">left|center_vertical</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">36dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:spinnerMode">dropdown</item>
        <item name="android:background">@drawable/combo_box</item>
        <item name="android:popupBackground">@drawable/neon_popup_bg</item>
    </style>


    <!-- Popup Styles -->
    <style name="ListPopupWindow" parent="@android:style/Widget.ListPopupWindow">
        <item name="android:popupBackground">@drawable/neon_popup_bg</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>

    <!-- .Dark kept as a distinct style because AppTheme.Dark references it by
         name, but it no longer needs its own popupBackground override (see
         ComboBox.Dark comment above for why).
         AppTheme.Dark가 이름으로 참조하기 때문에 별도 스타일로 남겨두지만,
         더 이상 자체 popupBackground 재정의가 필요 없음(이유는 위
         ComboBox.Dark 주석 참고) -->
    <style name="ListPopupWindow.Dark" parent="ListPopupWindow"/>

    <style name="PopupWindow" parent="@android:style/Widget.PopupWindow">
        <item name="android:popupBackground">@drawable/neon_popup_bg</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
    </style>

    <style name="PopupWindow.Dark" parent="PopupWindow"/>

    <style name="PopupMenu" parent="@android:style/Widget.PopupMenu">
        <item name="android:popupBackground">@drawable/neon_popup_bg</item>
    </style>

    <style name="PopupMenu.Dark" parent="PopupMenu"/>


    <!--
        ROOT-CAUSE FIX: the previous parent was @android:style/Theme.Dialog, a
        raw platform theme completely outside the app's own theme chain. Every
        ?attr/neon* reference used anywhere inside a ContentDialog - which is
        EVERY dialog built from this class, including every sub-dialog styled
        in earlier passes (Screen Effects, Controller Assignment, Graphics
        Driver, DX Wrapper, Task Manager, Motion Controls...) - silently failed
        to resolve, because those attrs are only ever given values inside
        Theme.App.Neon.Light/Dark, which this theme never inherited from. That
        is why all of that work never actually showed up on screen.
        Theme.MaterialComponents.Dialog is used as the parent instead: a proper
        floating-dialog base that is also MaterialComponents/AppCompat, so the
        Widget.AppCompat.* parents our Neon* widget styles build on (NeonSwitch,
        NeonComboBox, etc.) resolve correctly too - not just our own custom
        attrs. The neon items themselves are duplicated from
        Theme.App.Neon.Light/Dark rather than inherited, because a Dialog theme
        and an Activity theme cannot share one parent - this is the accepted
        way to keep "same brand, different window chrome" in sync: when the
        neon colour tokens change, both this block and themes_neon.xml need
        the same edit.
        근본 원인 수정: 기존 부모가 앱 자체 테마 체계 바깥에 있는 순수 플랫폼
        테마 @android:style/Theme.Dialog였음. ContentDialog로 만든 모든
        다이얼로그(Screen Effects, Controller Assignment, Graphics Driver,
        DX Wrapper, Task Manager, Motion Controls 등 이전에 손본 하위
        다이얼로그 전부 포함) 안에서 쓰는 ?attr/neon* 전부가 조용히 해석
        실패했음 - 그 속성들은 Theme.App.Neon.Light/Dark 안에서만 값이
        정해지는데, 이 테마는 거기서 상속받은 적이 없었기 때문. 그동안 작업한
        게 화면에 전혀 안 보였던 이유가 이것임.
        대신 Theme.MaterialComponents.Dialog를 부모로 씀: 제대로 된 플로팅
        다이얼로그 기반이면서 동시에 MaterialComponents/AppCompat이기도 해서,
        우리 Neon* 위젯 스타일(NeonSwitch, NeonComboBox 등)이 기반으로 삼는
        Widget.AppCompat.* 부모들도 - 우리 커스텀 속성뿐 아니라 - 제대로
        해석됨. 네온 항목 자체는 상속이 아니라 Theme.App.Neon.Light/Dark에서
        그대로 복제함. 다이얼로그 테마와 액티비티 테마는 부모를 하나로 공유할
        수 없어서임 - "같은 브랜드, 다른 창 틀"을 맞춰 두는 통상적인 방식이고,
        네온 색 값이 바뀌면 이 블록과 themes_neon.xml 양쪽을 같이 고쳐야 함
    -->
    <style name="ContentDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowBackground">@drawable/neon_dialog_bg</item>

        <item name="colorPrimary">@color/neon_l_accent</item>
        <item name="colorPrimaryDark">@color/neon_l_bg</item>
        <item name="colorAccent">@color/neon_l_accent</item>
        <item name="colorControlNormal">@color/neon_l_text_dim</item>
        <item name="colorControlActivated">@color/neon_l_accent</item>
        <item name="colorControlHighlight">@color/neon_l_glow_soft</item>
        <item name="android:textColorPrimary">@color/neon_l_text</item>
        <item name="android:textColorSecondary">@color/neon_l_text_dim</item>
        <item name="android:textColorHint">@color/neon_l_disabled</item>
        <!-- Text of dropdown lists (spinner popups): AppCompat takes it from
             textColorPrimaryDisableOnly, which a dark parent theme leaves white -
             white on the white popup in light mode, so the lists looked empty -->
        <!-- 드롭다운 목록(스피너 팝업) 글자 색: AppCompat은 textColorPrimaryDisableOnly에서
             가져오는데, 부모가 어두운 테마면 흰색으로 남음 - 라이트 모드의 흰 팝업 위에서
             흰 글자라 목록이 빈칸처럼 보였음 -->
        <item name="android:textColorPrimaryDisableOnly">@color/neon_l_text</item>
        <item name="android:colorBackground">@color/neon_l_bg</item>

        <item name="neonBg">@color/neon_l_bg</item>
        <item name="neonSurface">@color/neon_l_surface</item>
        <item name="neonSurfaceAlt">@color/neon_l_surface_alt</item>
        <item name="neonAccent">@color/neon_l_accent</item>
        <item name="neonAccent2">@color/neon_l_accent2</item>
        <item name="neonAccent3">@color/neon_l_accent3</item>
        <item name="neonText">@color/neon_l_text</item>
        <item name="neonTextDim">@color/neon_l_text_dim</item>
        <item name="neonGlow">@color/neon_l_glow</item>
        <item name="neonGlowMid">@color/neon_l_glow_mid</item>
        <item name="neonGlowSoft">@color/neon_l_glow_soft</item>
        <item name="neonDivider">@color/neon_l_divider</item>
        <item name="neonDisabled">@color/neon_l_disabled</item>
        <item name="neonScrim">@color/neon_l_scrim</item>
        <item name="neonScrimGradient">@drawable/neon_scrim_bottom_light</item>
    </style>

    <style name="ContentDialog.Dark" parent="ContentDialog">
        <item name="android:windowBackground">@drawable/neon_dialog_bg</item>

        <item name="colorPrimary">@color/neon_d_accent</item>
        <item name="colorPrimaryDark">@color/neon_d_bg</item>
        <item name="colorAccent">@color/neon_d_accent</item>
        <item name="colorControlNormal">@color/neon_d_text_dim</item>
        <item name="colorControlActivated">@color/neon_d_accent</item>
        <item name="colorControlHighlight">@color/neon_d_glow_soft</item>
        <item name="android:textColorPrimary">@color/neon_d_text</item>
        <item name="android:textColorSecondary">@color/neon_d_text_dim</item>
        <item name="android:textColorHint">@color/neon_d_disabled</item>
        <!-- Text of dropdown lists (spinner popups): AppCompat takes it from
             textColorPrimaryDisableOnly, which a dark parent theme leaves white -
             white on the white popup in light mode, so the lists looked empty -->
        <!-- 드롭다운 목록(스피너 팝업) 글자 색: AppCompat은 textColorPrimaryDisableOnly에서
             가져오는데, 부모가 어두운 테마면 흰색으로 남음 - 라이트 모드의 흰 팝업 위에서
             흰 글자라 목록이 빈칸처럼 보였음 -->
        <item name="android:textColorPrimaryDisableOnly">@color/neon_d_text</item>
        <item name="android:colorBackground">@color/neon_d_bg</item>

        <item name="neonBg">@color/neon_d_bg</item>
        <item name="neonSurface">@color/neon_d_surface</item>
        <item name="neonSurfaceAlt">@color/neon_d_surface_alt</item>
        <item name="neonAccent">@color/neon_d_accent</item>
        <item name="neonAccent2">@color/neon_d_accent2</item>
        <item name="neonAccent3">@color/neon_d_accent3</item>
        <item name="neonText">@color/neon_d_text</item>
        <item name="neonTextDim">@color/neon_d_text_dim</item>
        <item name="neonGlow">@color/neon_d_glow</item>
        <item name="neonGlowMid">@color/neon_d_glow_mid</item>
        <item name="neonGlowSoft">@color/neon_d_glow_soft</item>
        <item name="neonDivider">@color/neon_d_divider</item>
        <item name="neonDisabled">@color/neon_d_disabled</item>
        <item name="neonScrim">@color/neon_d_scrim</item>
        <item name="neonScrimGradient">@drawable/neon_scrim_bottom_dark</item>
    </style>


    <!-- TextView Styles -->
    <style name="TextView" parent="@android:style/Widget.TextView">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextView.Dark" parent="TextView">
        <item name="android:textColor">#ffffff</item>
    </style>

    <!-- CheckBox Styles -->
    <style name="CheckBox" parent="@android:style/Widget.CompoundButton.CheckBox">
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorSecondary">@color/colorPrimary</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CheckBox.Dark" parent="CheckBox">
        <item name="colorAccent">@color/colorAccentDark</item>
        <item name="android:textColorSecondary">@color/colorPrimaryDark</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Button Styles -->
    <!--
        BUG FIX ("Cancel" rendering as "Can"): android:lines="1" fixes the
        line COUNT but sets no ellipsize, so when a button's measured width
        ends up smaller than its text needs, Android has nothing better to do
        than clip the raw characters - no "...", just a silently cut-off word.
        singleLine + ellipsize="end" is the well-defined pairing: same
        one-line behaviour, but an ellipsis if it ever runs out of room
        instead of losing letters. minWidth is Material's own minimum tap
        target for a dialog button, so short labels ("OK") never look
        cramped even now that they can't be clipped either.
        버그 수정("Cancel"이 "Can"으로 보이던 것): android:lines="1"은 줄
        수만 고정하고 ellipsize는 안 정함. 그래서 버튼의 측정 폭이 글자보다
        좁아지면 안드로이드가 할 수 있는 게 "..." 표시 없이 원본 글자를
        그냥 잘라내는 것뿐이었음. singleLine + ellipsize="end"가 제대로 정의된
        조합임: 한 줄 동작은 같지만, 자리가 모자라면 글자가 사라지는 대신
        말줄임표가 붙음. minWidth는 Material의 다이얼로그 버튼 최소 탭
        영역값이고, 이제 잘릴 일이 없어진 "OK" 같은 짧은 라벨도 옹색해
        보이지 않게 함
    -->
    <style name="BaseButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:textSize">16sp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">24dp</item>
        <item name="android:paddingRight">24dp</item>
        <item name="android:textAllCaps">false</item>
    </style>


    <style name="ButtonNeutral" parent="BaseButton">
        <item name="android:background">@drawable/button_neutral</item>
        <item name="android:textColor">#ffffff</item>
    </style>


    <!-- Base ImageButton Styles -->
    <style name="BaseImageButton">
        <item name="android:layout_width">42dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:background">?selectableItemBackgroundBorderless</item>
        <item name="android:padding">4dp</item>
    </style>




    <!-- Line Styles -->


    <style name="HorizontalLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@color/colorPrimary</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>


    <style name="FieldSet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/neon_bordered_panel</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="FieldSetLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/window_background_color</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:layout_marginLeft">8dp</item>
        <item name="android:textColor">#bdbdbd</item>
    </style>

    <style name="FieldSetLabel.Dark" parent="FieldSetLabel">
        <item name="android:background">@color/window_background_color_dark</item>
        <item name="android:textColor">#cccccc</item>
    </style>

    <!-- Table Header Styles -->
    <!-- Background swapped to neon_table_head_bg (solid theme accent, see
         drawable comment for why). Text stays hardcoded white on purpose:
         the accent colours in both palettes are strong/saturated enough that
         white reads fine on either, and it's only used by task_manager_dialog.xml.
         배경을 neon_table_head_bg로 바꿈(진한 테마 강조색, 이유는 드로어블
         주석 참고). 글자는 일부러 흰색 고정으로 둠: 두 팔레트의 강조색 모두
         충분히 진하고 채도가 높아서 흰 글자가 둘 다에서 잘 읽히고,
         task_manager_dialog.xml에서만 쓰이는 스타일이라 범위도 좁음 -->
    <style name="TableHeadBackground">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/neon_table_head_bg</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <!-- Help Button Styles -->
    <style name="HelpButton">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginLeft">4dp</item>
        <item name="android:src">@drawable/icon_help</item>
        <item name="tint">#e0e0e0</item>
    </style>


    <style name="Base.Widget.AppCompat.SeekBar" parent="@android:style/Widget.Material.SeekBar" />
    <style name="Base.Widget.AppCompat.SeekBar.Discrete" parent="@style/Base.Widget.AppCompat.SeekBar">
        <item name="tickMark">@drawable/abc_seekbar_tick_mark_material</item>
    </style>

    <style name="Preference.SeekBarPreference" parent="@style/Preference">
        <item name="android:layout">@layout/preference_widget_seekbar</item>
        <item name="adjustable">true</item>
        <item name="showSeekBarValue">true</item>
        <item name="updatesContinuously">false</item>
    </style>
    <style name="Preference.SeekBarPreference.Material" parent="@style/Preference.SeekBarPreference">
        <item name="android:layout">@layout/preference_widget_seekbar_material</item>
        <item name="adjustable">true</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="iconSpaceReserved">@bool/config_materialPreferenceIconSpaceReserved</item>
        <item name="showSeekBarValue">false</item>
    </style>

    <style name="Preference">
        <item name="android:layout">@layout/preference</item>
    </style>
    <style name="Preference.Category" parent="@style/Preference">
        <item name="android:layout">@layout/preference_category</item>
        <item name="android:selectable">false</item>
        <item name="android:shouldDisableView">false</item>
    </style>
    <style name="Preference.Category.Material" parent="@style/Preference.Category">
        <item name="android:layout">@layout/preference_category_material</item>
        <item name="allowDividerAbove">true</item>
        <item name="allowDividerBelow">true</item>
        <item name="iconSpaceReserved">@bool/config_materialPreferenceIconSpaceReserved</item>
    </style>
    <style name="Preference.CheckBoxPreference" parent="@style/Preference">
        <item name="android:widgetLayout">@layout/preference_widget_checkbox</item>
    </style>
    <style name="Preference.CheckBoxPreference.Material" parent="@style/Preference.CheckBoxPreference">
        <item name="android:layout">@layout/preference_material</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">true</item>
        <item name="iconSpaceReserved">@bool/config_materialPreferenceIconSpaceReserved</item>
    </style>
    <style name="Preference.DialogPreference" parent="@style/Preference">
        <item name="android:positiveButtonText">@android:string/ok</item>
        <item name="android:negativeButtonText">@android:string/cancel</item>
    </style>
    <style name="Preference.DialogPreference.EditTextPreference" parent="@style/Preference.DialogPreference">
        <item name="android:dialogLayout">@layout/preference_dialog_edittext</item>
    </style>
    <style name="Preference.DialogPreference.EditTextPreference.Material" parent="@style/Preference.DialogPreference.EditTextPreference">
        <item name="android:layout">@layout/preference_material</item>
