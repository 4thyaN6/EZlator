<?xml version="1.0" encoding="utf-8"?>
<!-- MaterialSwitch thumb tint by state -->
<!-- MaterialSwitch 손잡이 색상, 상태별임 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/neonAccent" android:state_checked="true" />
    <item android:color="?attr/neonSurface" android:state_enabled="false" />
    <item android:color="?attr/neonTextDim" />
</selector>
