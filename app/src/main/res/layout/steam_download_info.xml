<?xml version="1.0" encoding="utf-8"?>
<!-- Size block shown before a Steam download (SteamSpaceCheck.fillInfo): game size,
     internal storage and SD card (free / total) and the storage the game goes to,
     as a label column and a value column. Sits on the right of the game name in
     the download confirm sheet, and at the top of the not-enough-space dialog
     스팀 다운로드 전에 보여 주는 용량 블록(SteamSpaceCheck.fillInfo): 게임 용량,
     내장 메모리와 SD카드(남음 / 전체), 게임이 설치될 저장소를 이름 열과 값 열로
     보여 줌. 받기 확인창에서는 게임 이름 오른쪽에, 공간 부족 창에서는 맨 위에 둠 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Labels / 이름 열 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_size"
            android:textColor="?attr/neonTextDim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_internal"
            android:textColor="?attr/neonTextDim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_sd"
            android:textColor="?attr/neonTextDim" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_target"
            android:textColor="?attr/neonTextDim" />
    </LinearLayout>

    <!-- Values, right aligned / 값 열(오른쪽 정렬) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVInfoSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:textStyle="bold"
            android:text="@string/steam_dl_info_loading"
            android:textColor="?attr/neonText" />

        <TextView
            android:id="@+id/TVInfoInternal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_loading"
            android:textColor="?attr/neonText" />

        <TextView
            android:id="@+id/TVInfoSd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_loading"
            android:textColor="?attr/neonText" />

        <TextView
            android:id="@+id/TVInfoTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/steam_dl_info_loading"
            android:textColor="?attr/neonAccent" />
    </LinearLayout>
</LinearLayout>
