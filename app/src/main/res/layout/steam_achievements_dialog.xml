<?xml version="1.0" encoding="utf-8"?>
<!--
    Steam achievement list (SteamAchievementsDialog). Laid out like a handheld
    console trophy list: title, progress header (big percent, unlocked / total,
    bar), filter chips, scrolling rows, close button. Neon theme colours only.
    스팀 도전과제 목록(SteamAchievementsDialog)임. 휴대용 게임기 트로피 목록처럼
    구성함: 제목, 진행률 머리(큰 퍼센트, 달성 / 전체, 막대), 필터 칩, 스크롤되는
    줄, 닫기 버튼. 색은 네온 테마만 씀
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/neon_dialog_bg"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/TVAchTitle"
            style="@style/NeonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2" />

        <TextView
            style="@style/NeonCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/steam_achievements" />

        <!-- Progress header: big percent on the left, count and bar on the right -->
        <!-- 진행률 머리: 왼쪽에 큰 퍼센트, 오른쪽에 개수와 막대 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/neon_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <TextView
                android:id="@+id/TVAchPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="84dp"
                android:text="0%"
                android:textColor="?attr/neonAccent"
                android:textSize="32sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVAchCount"
                    style="@style/NeonBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <ProgressBar
                    android:id="@+id/PBAchProgress"
                    style="@style/NeonProgressLinear"
                    android:layout_marginTop="8dp"
                    android:progress="0" />
            </LinearLayout>
        </LinearLayout>

        <!-- Filter chips / 필터 칩 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/TVAchFilterAll"
                style="@style/NeonChip"
                android:text="@string/steam_achievements_filter_all" />

            <TextView
                android:id="@+id/TVAchFilterUnlocked"
                style="@style/NeonChip"
                android:layout_marginStart="8dp"
                android:text="@string/steam_achievements_filter_unlocked" />

            <TextView
                android:id="@+id/TVAchFilterLocked"
                style="@style/NeonChip"
                android:layout_marginStart="8dp"
                android:text="@string/steam_achievements_filter_locked" />
        </LinearLayout>

        <TextView
            android:id="@+id/TVAchNotice"
            style="@style/NeonCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <!-- List with the loading ring over it / 목록과 그 위의 불러오는 중 고리 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RVAchievements"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="4dp" />

            <ProgressBar
                android:id="@+id/PBAchLoading"
                style="@style/NeonProgressRing"
                android:layout_gravity="center"
                android:indeterminate="true" />
        </FrameLayout>

        <Button
            android:id="@+id/BTAchClose"
            style="@style/NeonButtonGhost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/steam_achievements_close" />
    </LinearLayout>
</FrameLayout>
