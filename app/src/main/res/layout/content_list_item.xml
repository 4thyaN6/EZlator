<?xml version="1.0" encoding="utf-8"?>
<!--
    Content catalog row, rebuilt as a neon card. Ids and widget types are
    unchanged (IVIcon / TVVersionName / TVVersionCode / BTMenu / BTDownload /
    Progress) so ContentsFragment's ViewHolder binds without any Java change.
    Contents 카탈로그 행을 네온 카드로 다시 만듦. id와 위젯 종류는 그대로라
    (IVIcon / TVVersionName / TVVersionCode / BTMenu / BTDownload / Progress)
    ContentsFragment의 ViewHolder가 Java 수정 없이 그대로 붙음
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/neon_card_bg"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="10dp">

    <!-- Tinted with the theme accent instead of the old colorPrimaryDark blue -->
    <!-- 옛 colorPrimaryDark 파랑 대신 테마 강조색으로 칠함 -->
    <!-- Circular badge, same drawable NeonIconMenuButton uses app-wide, so
         every content type's icon sits inside a consistent ring regardless
         of whether its own source art (some are baked-in PNGs, some are bare
         vector paths like the wrench for GraphicTools) has any backdrop of
         its own. Padding insets the icon so it doesn't crowd the ring.
         앱 전역에서 NeonIconMenuButton이 쓰는 것과 같은 드로어블로 만든 원형
         배지임. 이걸로 콘텐츠 타입마다 아이콘 원본 소스(일부는 배경이 이미
         그려진 PNG, GraphicTools의 렌치처럼 일부는 배경 없는 순수 벡터
         패스)가 제각각이어도 다 같은 테두리 안에 들어감. 패딩으로 아이콘을
         안쪽으로 밀어서 테두리에 안 붙게 함 -->
    <ImageView
        android:id="@+id/IVIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/neon_icon_button_bg"
        android:padding="8dp"
        android:scaleType="fitCenter"
        app:tint="?attr/neonAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVVersionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/neonText"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/TVVersionCode"
            style="@style/NeonCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!--
        BUG FIX: measured both PNGs' actual ink (non-transparent pixels)
        against their canvas. icon_list_item_menu's three dots fill only 25%
        of its canvas width; icon_popup_menu_download's glyph fills 75% of
        its canvas. Same 40dp button, same 8dp padding either way - but the
        download glyph renders roughly 3x wider than the kebab dots, which
        is the "download icon looks bigger" seen on phone width where the
        two buttons sit closer together. Extra padding on BTDownload alone
        brings its visible glyph down to match BTMenu's visual weight
        without touching either source image.
        버그 수정: 두 PNG의 실제 잉크(투명 아닌 픽셀)를 캔버스 대비로 재 보니,
        icon_list_item_menu의 점 3개는 캔버스 폭의 25%만 채우고,
        icon_popup_menu_download 그림은 75%를 채움. 버튼도 40dp, 여백도
        8dp로 똑같은데 다운로드 그림이 케밥 점보다 약 3배 넓게 그려짐 - 폰
        너비에서 두 버튼이 더 붙어 보일 때 "다운로드 아이콘이 커 보인다"던
        그 현상임. BTDownload에만 여백을 더 줘서 원본 이미지는 안 건드리고
        보이는 그림 크기만 BTMenu와 비슷하게 맞춤
    -->
    <!-- Download state chip: filled "Installed" for a downloaded entry, outlined
         "Not installed" for a catalog entry (selected state of neon_chip_bg) -->
    <!-- 설치 상태 칩: 받은 항목은 채운 "설치됨", 카탈로그 항목은 테두리만 있는
         "미설치"(neon_chip_bg의 선택 상태) -->
    <TextView
        android:id="@+id/TVStatus"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/neon_chip_bg"
        android:gravity="center"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:singleLine="true"
        android:textColor="?attr/neonText"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/BTMenu"
        style="@style/NeonIconMenuButton"
        android:src="@drawable/icon_list_item_menu" />

    <!-- The extra 13dp padding was removed. It only compensated for
         the old scaleType="center"; with fitCenter (NeonIconMenuButton) it
         shrank the download glyph to a 14dp box
         추가 여백 13dp를 지움. 예전 scaleType="center"를 보정하던 값이었는데,
         fitCenter(NeonIconMenuButton)에서는 다운로드 그림을 14dp 칸으로 줄여 버렸음 -->
    <ImageButton
        android:id="@+id/BTDownload"
        style="@style/NeonIconMenuButton"
        android:tint="?attr/neonAccent"
        android:src="@drawable/icon_popup_menu_download" />

    <!-- Indeterminate ring, not a percentage bar: Downloader.downloadFile()
         reports no progress fraction for a single file, so a determinate bar
         would just sit at a fake value. The 0-100% bar in settings/first-run
         is a different case where the overall step count IS known.
         퍼센트 막대가 아니라 고리 스피너임: Downloader.downloadFile()이 파일
         하나짜리 다운로드에는 진행률을 안 주므로, 퍼센트 막대를 쓰면 가짜 값에
         멈춰 있게 됨. 설정/최초 실행의 0~100% 막대는 전체 단계 수를 아는
         다른 경우임 -->
    <ProgressBar
        android:id="@+id/Progress"
        style="@style/NeonProgressRing"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="4dp"
        android:visibility="gone" />
</LinearLayout>
