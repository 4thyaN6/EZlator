<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/play_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Number of times played: "
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/playtime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Playtime: "
        android:textSize="16sp"
        android:paddingBottom="8dp" />

    <Button
        style="@style/NeonButtonGhost"
        android:id="@+id/reset_properties"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="Reset Properties" />

    <!-- Close under Reset (the dialog's Cancel / OK bar is hidden)
         초기화 아래 닫기(대화상자의 취소 / 확인 줄은 숨김) -->
    <Button
        style="@style/NeonButtonPrimary"
        android:id="@+id/BTCloseProperties"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:text="@string/shortcut_close" />

</LinearLayout>
